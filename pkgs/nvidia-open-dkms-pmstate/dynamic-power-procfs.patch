--- a/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c
+++ b/src/nvidia/arch/nvalloc/unix/src/dynamic-power.c
@@ -287,7 +287,7 @@
  *
  * @return      TRUE if the GPU appears to be currently idle; FALSE otherwise.
  */
-static NvBool RmCanEnterGcxUnderGpuLock(
+static NvBool RmCanEnterGcxUnderGpuLockUnrecorded(
     OBJGPU *pGpu
 )
 {
@@ -324,6 +324,25 @@
 }
 
 /*!
+ * @brief: RmCanEnterGcxUnderGpuLockUnrecorded(), recording the result and
+ * its time for the procfs power file.
+ *
+ * Assumes the GPU lock is held.
+ */
+static NvBool RmCanEnterGcxUnderGpuLock(
+    OBJGPU *pGpu
+)
+{
+    nv_priv_t *nvp   = NV_GET_NV_PRIV(NV_GET_NV_STATE(pGpu));
+    NvBool     bIdle = RmCanEnterGcxUnderGpuLockUnrecorded(pGpu);
+
+    nvp->dynamic_power.last_idle_check_idle = bIdle;
+    nvp->dynamic_power.last_idle_check_ns   = osGetMonotonicTimeNs();
+
+    return bIdle;
+}
+
+/*!
  * @brief: Check the feasibility of GPU engaging in a GCx cycle.
  *
  * Takes the GPU lock.
@@ -3227,6 +3246,10 @@
     const char       *pDynamicPowerStatus = "?";
     const char       *pS0ixStatus = "?";
     const char       *pDbStatus = "?";
+    const char       *pDynamicPowerState = "?";
+    NvS32             dynamicPowerRefcount = -1;
+    const char       *pIdleCheckResult = "?";
+    NvU64             idleCheckAgeMs = ~(NvU64)0;  // no check yet
 
     NV_ENTER_RM_RUNTIME(sp,fp);
     threadStateInit(&threadState, THREAD_STATE_FLAGS_NONE);
@@ -3251,6 +3274,18 @@
             pGcoffSupported = RmGetGpuGcxSupport(pGpu, NV_FALSE);
             pS0ixStatus = pNvp->s0ix_pm_enabled ? "Enabled" : "Disabled";
             pDbStatus = RmGetDynamicBoostSupport(pNv);
+            pDynamicPowerState = nv_dynamic_power_state_string(pNvp->dynamic_power.state);
+            dynamicPowerRefcount = pNvp->dynamic_power.refcount;
+            if (pNvp->dynamic_power.last_idle_check_ns == 0)
+            {
+                pIdleCheckResult = "none";
+            }
+            else
+            {
+                pIdleCheckResult = pNvp->dynamic_power.last_idle_check_idle ? "idle" : "busy";
+                idleCheckAgeMs = (osGetMonotonicTimeNs() -
+                                  pNvp->dynamic_power.last_idle_check_ns) / 1000000;
+            }
             // UNLOCK: release per device lock
             rmGpuGroupLockRelease(gpuMask, GPUS_LOCK_FLAGS_NONE);
         }
@@ -3268,5 +3303,9 @@
     powerInfo->gcoff_support = pGcoffSupported;
     powerInfo->s0ix_status = pS0ixStatus;
     powerInfo->db_support = pDbStatus;
+    powerInfo->dynamic_power_state = pDynamicPowerState;
+    powerInfo->dynamic_power_refcount = dynamicPowerRefcount;
+    powerInfo->idle_check_result = pIdleCheckResult;
+    powerInfo->idle_check_age_ms = idleCheckAgeMs;
 }
 
